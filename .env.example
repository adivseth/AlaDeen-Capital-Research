# Optional. The easiest way to set keys and models is the dashboard Settings page (aladeen dashboard).
# Copy to .env only if you prefer environment variables. Never commit .env.

# ---- LLM provider (default: anthropic) ----
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# ALADEEN_LLM_PROVIDER=anthropic          # anthropic | openai | google | xai | openrouter | ollama | openai_compatible
# ALADEEN_DEEP_MODEL=claude-opus-5-5      # senior tier: CIO, Valuation Analyst, Chief Risk Officer, council chair
# ALADEEN_QUICK_MODEL=claude-sonnet-5-5   # analyst tier: research desks, bull/bear advocates, council advisors
# ALADEEN_DEEP_PROVIDER=                  # optional: a different provider for the deep tier
# ALADEEN_QUICK_PROVIDER=
# ALADEEN_BACKEND_URL=                    # for ollama / openai_compatible / gateways
# ALADEEN_TEMPERATURE=0.2

# ---- Optional backup data sources (used only when the primary source fails) ----
# ALPHAVANTAGE_API_KEY=                   # prices when Yahoo Finance fails
# FIRECRAWL_API_KEY=                      # annual reports / concalls when BSE blocks the download
# EXA_API_KEY=                            # second backup for documents

# ---- Workflow ----
# ALADEEN_MAX_DEBATE_ROUNDS=1
# ALADEEN_NO_COUNCIL=1
# ALADEEN_DOCUMENT_MODE=focused           # focused | full

# ---- Market inputs (dated defaults; review before relying on a valuation) ----
# ALADEEN_RISK_FREE_RATE=0.0722
# ALADEEN_EQUITY_RISK_PREMIUM=0.07

# ---- Paths ----
# ALADEEN_HOME=~/.aladeen
# ALADEEN_RESULTS_DIR=~/.aladeen/research
# ALADEEN_CALL_LOG=~/.aladeen/call_log.csv

# ---- Optional Google Sheets call log (pip install "aladeen-capital-research[sheets]") ----
# ALADEEN_GSHEETS_ID=
# ALADEEN_GSHEETS_CREDENTIALS=/path/to/service-account.json

# ---- Report branding ----
# ALADEEN_FIRM_NAME=AlaDeen Capital Research

# ---- Dashboard ----
# ALADEEN_PORT=8765
# ALADEEN_HOST=127.0.0.1                  # keep 127.0.0.1 unless running in Docker
