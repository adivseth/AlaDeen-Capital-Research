{% if fp.fact_resolutions %}
<details><summary>Filed evidence and source differences</summary>
<table><thead><tr><th>Annual fact</th><th>Vendor readings</th><th>Research value</th><th>Filed evidence</th></tr></thead><tbody>
{% for f in fp.fact_resolutions %}<tr><td>{{ f.period }} · {{ f.scope }} · {{ f.metric }} ({{ f.unit }})</td>
<td>{% for name, value in f.feeds.items() %}{{ name }} {{ value }} {% endfor %}</td>
<td>{{ f.value if f.status == 'verified' else 'Pending verification' }}</td>
<td>{% for e in f.evidence %}<a href="{{ e.url }}#page={{ e.page }}">{{ e.title }}, PDF p.{{ e.page }}</a> · {{ e.line }} {% endfor %}</td></tr>{% endfor %}
</tbody></table></details>
{% endif %}
